# Şablon — gerçek değerler deploy/compose/.env'de (gitignore). Üretmek için: node tools/deploy/yigin.mjs sirlar
# Değerler boş bırakılır; yığın eksik sırla açılmaz.
POSTGRES_PASSWORD=
JWT_SECRET=
SESSION_SECRET=
CONTROL_DB_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
INTEGRATION_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
TAX_ID_HMAC_KEY=
# Satış portalı (D27, D40): veritabanı rolü eworks_sales ve satışçıların 2FA gizli anahtarlarını mühürleyen anahtar
# (kaybedilirse satışçılar 2FA'yı yeniden kurar). İlk satışçı: node tools/deploy/yigin.mjs satis-kullanici --eposta … --ad "…"
SALES_DB_PASSWORD=
SALES_TOTP_KEY=
# Demo profili: hesap-ac görevinin açtığı ofis yöneticisinin parolası (giriş e-postası demo@eworks.test;
# rehber: docs/gelistirici-rehberi/baslangic.md §3 "Demo hesabı")
DEMO_SIFRE=
# İsteğe bağlı: DEMO_EPOSTA=demo@eworks.test, DEMO_OFIS=, DEMO_AD=, SAHTE_GIB_SIFRE=demo-gib-sifre
# Web'in dışarı açılan portu ve tarayıcıdaki adres
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080
# Satış portalının portu (üretimde yalnız 127.0.0.1'e açılır; SSH tüneliyle erişilir)
SATIS_PORT=8081
# İsteğe bağlı (yorumu kaldırıp değiştir; ayrıntı deploy/README.md):
# GELISTIRME_DB_CONTROL_PORT=54320
# GELISTIRME_DB_SHARD_01_PORT=54321
# GELISTIRME_DB_SHARD_02_PORT=54322
# GELISTIRME_AUTH_PORT=59999
# GELISTIRME_REDIS_PORT=56379
# GELISTIRME_S3_PORT=58333
# GIB_ISTEK_DK=60
# GIB_ERISIM_YOLU=servis
# ERISIM_GIB_EBEYANNAME=
# ERISIM_GIB_IVD=
# HATA_AYIKLAMA_ISCI_PORT=9230
# HATA_AYIKLAMA_PYTHON_PORT=5678
# Üretim (node tools/deploy/yigin.mjs uretim; docs/gelistirici-rehberi/vps-kurulum.md):
# EWORKS_ALAN_ADI=portal.ornek.com.tr
# PUBLIC_URL=https://portal.ornek.com.tr
# URETIM_HTTP_PORT=80
# URETIM_HTTPS_PORT=443
# YIGIN_KIPI=demo   (betik yazar, elle değiştirme: demo | gelistirme | debug | uretim;
#                   her kipin ayarları: docs/gelistirici-rehberi/kipler.md)
