{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eworks.local/contracts/integration/eworks.gib.contracts.v1.schema.json",
  "title": "GİB Geçerli E-Beyanname Sözleşmeleri Listesi — ACL sonucu",
  "description": "Python ACL'in (services/integration) GİB sözleşme listesinden ürettiği yayımlanmış dil. Alan kuralı içermez; uygulayıcı apps/worker'daki tax-filing use-case'idir. Eski robotun eworks.gib.contracts.v1 biçiminden türetilmiştir (ofis/kişi kimliği yok, kaynak türü açık).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jobId", "sourceType", "observedAt", "count", "contracts"],
  "properties": {
    "schema": { "const": "eworks.gib.contracts.v1" },
    "jobId": { "type": "string", "format": "uuid" },
    "sourceType": { "enum": ["gib_live", "sahte_gib"], "description": "sahte_gib: demo/test ortamında sahte GİB sunucusu (canlı doğrulama sayılmaz, D33)" },
    "observedAt": { "type": "string", "format": "date-time" },
    "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxNumber", "identityNumber", "name", "taxOffice", "number", "date", "service", "registeredAt", "type"],
        "properties": {
          "taxNumber": { "type": "string", "pattern": "^([0-9]{10})?$" },
          "identityNumber": { "type": "string", "pattern": "^([0-9]{11})?$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "taxOffice": { "type": "string", "maxLength": 120 },
          "number": { "type": "string", "minLength": 1, "maxLength": 100 },
          "date": { "type": "string", "maxLength": 40 },
          "service": { "type": "string", "maxLength": 200 },
          "registeredAt": { "type": "string", "maxLength": 40 },
          "type": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
