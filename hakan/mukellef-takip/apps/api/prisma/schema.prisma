generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Mali müşavir bürosu (her büro ayrı bir müşteri / tenant)
model Tenant {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  users        User[]
  companies    Company[]
  subscription Subscription?
  payments     Payment[]

  // Fatura bilgileri (ödeme sağlayıcısına alıcı bilgisi olarak gönderilir)
  billingName        String? // Unvan / ad soyad
  billingContactName String? // Yetkili kişi (iyzico alıcı adı-soyadı)
  billingTaxNumber   String? // VKN / TCKN
  billingTaxOffice   String?
  billingAddress     String?
  billingCity        String?
  billingEmail       String?
  billingPhone       String? // +905xxxxxxxxx
  notifications Notification[]
  assistantConversations AssistantConversation[]
  inboxSnoozes  InboxSnooze[]

  // Güvenlik politikası: açıksa iki adımlı doğrulaması olmayan kullanıcı kurulumu yapmadan portalı kullanamaz
  require2fa    Boolean       @default(false)
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false) // Yönetici geçici şifre verdiyse ilk girişte değiştirilir
  // Oturum sürümü: şifre değişimi, devre dışı bırakma, 2FA değişikliğinde artar; eski JWT'ler geçersizleşir
  sessionVersion     Int       @default(0)
  lastLoginAt        DateTime?
  // Art arda hatalı giriş kilidi (veritabanında: yeniden başlatmada ve birden fazla sunucuda da geçerli)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?

  // İki adımlı doğrulama (TOTP). Gizli anahtar VaultService ile şifreli.
  totpSecretEnc      String?   // Kurulum sırasında da tutulur; totpEnabledAt dolunca etkin sayılır
  totpEnabledAt      DateTime?
  totpLastStep       Int?      // Aynı kodun ikinci kez kullanılmasını engeller
  recoveryCodeHashes String[]  @default([]) // Tek kullanımlık kurtarma kodlarının SHA-256 özetleri

  // WhatsApp bildirimi: sadece kullanıcı telefonunu girip açık rıza verdiyse gönderilir
  phone              String?   // E.164, başında + olmadan (905xxxxxxxxx)
  whatsappEnabled    Boolean   @default(false)
  whatsappOptInAt    DateTime? // Rıza verildiği an (WhatsApp politikası gereği saklanır)
  notifyCategories   NotificationCategory[] @default([TEBLIGAT, SGK_RAPOR, BEYANNAME_SON_GUN, BEYANNAME_GECIKTI, EDEFTER])

  notificationReads  NotificationRead[]
  deliveries         NotificationDelivery[]
  assistantConversations AssistantConversation[]
}

// Lisans ve firma kotası ("Lisans: 359 gün", "Kota: 126/126")
model Subscription {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         String   @default("standart")
  companyQuota Int      @default(50)
  expiresAt    DateTime
}

enum CompanyType {
  SIRKET      // Şirket (bilanço)
  SAHIS       // Şahıs (işletme)
  BASIT_USUL  // Basit usul
}

// Mükellef (firma) kartı
model Company {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title      String      // Unvan / ad soyad
  taxNumber  String      // VKN (10 hane) veya TCKN (11 hane)
  taxOffice  String?
  type       CompanyType
  isActive   Boolean     @default(true)
  phone      String?
  email      String?
  notes      String?
  createdAt  DateTime    @default(now())
  tebligats  ETebligat[]

  // e-Defter: firma e-Defter kullanıyor mu, berat yükleme tercihi (GİB'deki seçimle aynı olmalı)
  eDefterEnabled    Boolean           @default(false)
  eDefterPreference EDefterPreference @default(MONTHLY)
  eDefterBerats     EDefterBerat[]
  petitions         Petition[]
  updatedAt  DateTime    @updatedAt
  sgkWorkplaces SgkWorkplace[]
  obligations   CompanyObligation[]
  declarations  Declaration[]
  invoices      Invoice[]
  payrollRuns   PayrollRun[]

  @@unique([tenantId, taxNumber])
  @@index([tenantId])
}

enum SyncStatus {
  NEVER
  RUNNING
  OK
  ERROR
}

// SGK işyeri / şube
model SgkWorkplace {
  id           String  @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registryNo   String  // İşyeri sicil numarası
  name         String?
  isBranch     Boolean @default(false)

  // Vizite web servisi giriş bilgileri. Şifre AES-256-GCM ile şifreli tutulur
  // ve API yanıtlarında asla dönmez (bkz. VaultService).
  viziteUsername      String?   // Vizite kullanıcı kodu (T.C. kimlik no)
  viziteWorkplaceCode String?   // Vizite işyeri kodu (4 hane)
  viziteSecretEnc     String?
  credentialsUpdatedAt DateTime?

  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus @default(NEVER)
  lastSyncError  String?

  // 4A işe giriş/işten ayrılış (Sigortalı Tescil) giriş bilgileri. Vizite'den ayrı şifrelerdir:
  // e-Bildirge kullanıcı adı + sistem şifresi + işyeri şifresi. Şifreler AES-256-GCM ile şifreli.
  tescilUsername             String?
  tescilSystemPasswordEnc    String?
  tescilWorkplacePasswordEnc String?
  tescilCredentialsUpdatedAt DateTime?

  tescilLastSyncAt     DateTime?
  tescilLastSyncStatus SyncStatus @default(NEVER)
  tescilLastSyncError  String?

  reports    SgkReport[]
  employment EmploymentEvent[]
  bildirges  EBildirgeDocument[]
  payrollRuns PayrollRun[]

  @@index([companyId])
}

enum ReportStatus {
  PENDING   // İşverenin çalışmazlık bildirimi bekleniyor
  APPROVED  // Çalışmazlık bildirimi yapıldı (SGK'da onaylı)
}

// Vizite (e-Rapor) — SGK raporAramaTarihile / onayliRaporlarTarihile verileri
model SgkReport {
  id            String       @id @default(cuid())
  workplaceId   String
  workplace     SgkWorkplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  medulaRaporId String
  tckn          String
  fullName      String
  vaka          Int          // 1 İş kazası, 2 Meslek hastalığı, 3 Hastalık, 4 Analık
  vakaAdi       String?
  policlinicDate DateTime?
  startDate     DateTime?
  endDate       DateTime?
  workControlDate DateTime?  // İş başı kontrol tarihi
  sgkStatusCode String?      // RAPORDURUMU
  facilityName  String?
  status        ReportStatus @default(PENDING)
  approvedAt    DateTime?
  raw           Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([workplaceId, medulaRaporId])
  @@index([workplaceId, status])
}

enum EmploymentEventType {
  ENTRY // İşe giriş bildirgesi
  EXIT  // İşten ayrılış bildirgesi
}

// SGK'ya verilmiş 4A işe giriş / işten ayrılış bildirgeleri (şimdilik sadece okunur)
model EmploymentEvent {
  id             String              @id @default(cuid())
  workplaceId    String
  workplace      SgkWorkplace        @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  type           EmploymentEventType
  tckn           String
  fullName       String
  eventDate      DateTime            // Giriş veya ayrılış tarihi
  insuranceType  String?             // Sigortalı türü kodu (0: Tüm sigorta kolları, 2: Emekli, 7: Çırak …)
  occupationCode String?             // Meslek kodu (ISCO-08)
  exitReasonCode String?             // İşten ayrılış nedeni kodu (sadece EXIT)
  exitReason     String?
  referenceNo    String?             // SGK referans / belge numarası
  raw            Json?
  createdAt      DateTime            @default(now())

  @@unique([workplaceId, type, tckn, eventDate])
  @@index([workplaceId, type, eventDate])
}

enum DeclarationType {
  KDV1          // Katma Değer Vergisi (aylık)
  MUHSGK        // Muhtasar ve Prim Hizmet (aylık)
  DAMGA         // Damga Vergisi (aylık)
  GECICI_VERGI  // Geçici Vergi (üç aylık; 1.–3. dönem)
  YILLIK_GELIR  // Yıllık Gelir Vergisi
  KURUMLAR      // Kurumlar Vergisi
}

enum DeclarationSource {
  MANUAL  // Kullanıcı elle işaretledi
  GIB       // GİB'den çekildi (demo modunda sahte)
  EXTENSION // Kullanıcı GİB sayfasını tarayıcı eklentisiyle aktardı
}

// Firmanın vermekle yükümlü olduğu beyannameler (firma türüne göre varsayılanla başlar, düzenlenebilir)
model CompanyObligation {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      DeclarationType
  active    Boolean         @default(true)

  @@unique([companyId, type])
}

// Verilmiş beyanname. period: aylık "2026-09", üç aylık "2026-Q3", yıllık "2026"
model Declaration {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          DeclarationType
  period        String
  filedAt       DateTime
  accrualAmount Decimal?          @db.Decimal(14, 2) // Tahakkuk tutarı (TL)
  referenceNo   String?           // GİB beyanname / tahakkuk numarası
  source        DeclarationSource
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  @@unique([companyId, type, period])
  @@index([type, period])
}

// Tarayıcı eklentisi gibi istemciler için kapsamı dar, iptal edilebilir anahtar.
// Anahtarın kendisi saklanmaz, sadece SHA-256 özeti tutulur; oluşturulurken bir kez gösterilir.
model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String    // Listede ayırt etmek için ilk karakterler ("mt_ab12…")
  scopes     String[]  // ör. ["declarations:import"]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

enum EDefterPreference {
  MONTHLY   // Aylık yükleme
  QUARTERLY // Geçici vergi dönemleri bazında yükleme
}

// e-Defter berat yüklemesi. period: aylık "2026-03" / dönemsel "2026-Q1".
// dueDateOverride: GİB süre uzatımı veya kuralın tarih veremediği dönemler (Ekim–Aralık) için elle girilen son gün.
model EDefterBerat {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period          String
  uploadedAt      DateTime?
  dueDateOverride DateTime?
  note            String?
  updatedById     String?
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, period])
}

// Dilekçe şablonu. tenantId boşsa sistemin hazır şablonudur; büro kendi şablonlarını ekleyebilir.
// body içindeki {{alan}} yer tutucuları belge üretilirken doldurulur.
model PetitionTemplate {
  id        String     @id @default(cuid())
  tenantId  String?
  title     String
  category  String     // "Vergi dairesi", "SGK", "Genel"
  body      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  petitions Petition[]

  @@index([tenantId])
}

// Üretilmiş dilekçe (geçmiş/arşiv)
model Petition {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId  String?
  template    PetitionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title       String
  content     String            // Kullanıcının son düzenlediği tam metin
  createdById String
  createdAt   DateTime          @default(now())

  @@index([companyId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Lisans ödemesi. Tutar sunucuda paket tablosundan hesaplanır; istemciden gelen tutara güvenilmez.
model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        String
  months      Int
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("TRY")
  status      PaymentStatus @default(PENDING)
  provider    String        // "demo", "iyzico", "paytr"…
  providerRef String?       // Sağlayıcının ödeme numarası (iyzico paymentId)
  // iyzico ödeme formu token'ı: geri dönüşte ödeme bununla bulunur ve iyzico'ya sorulur
  providerToken String?     @unique
  fraudStatus   Int?        // iyzico: 1 onaylı, 0 incelemede, -1 reddedildi
  createdById String
  createdAt   DateTime      @default(now())
  paidAt      DateTime?
  error       String?

  @@index([tenantId, createdAt])
}

enum EBildirgeSource {
  EXTENSION // SGK sayfasından eklentiyle aktarıldı
  DEMO
}

// SGK e-Bildirge'de onaylanmış aylık prim ve hizmet belgeleri (sayfadan okunur).
// Aynı dönem ve işyerinde belge türü + kanun no + mahiyet (asıl/ek/iptal) bir belgeyi tanımlar.
model EBildirgeDocument {
  id            String          @id @default(cuid())
  workplaceId   String
  workplace     SgkWorkplace    @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  period        String          // "2026-09"
  documentType  String          // Belge türü kodu, ör. "01"
  lawNo         String          // Kanun no, ör. "05510"; yoksa "-"
  kind          String          // Mahiyet: ASIL | EK | IPTAL
  insuredCount  Int?            // Sigortalı sayısı
  totalDays     Int?            // Toplam prim ödeme günü
  premiumBase   Decimal?        @db.Decimal(14, 2) // Prime esas kazanç
  accrualAmount Decimal?        @db.Decimal(14, 2) // Tahakkuk / prim tutarı
  approvedAt    DateTime?
  referenceNo   String?
  source        EBildirgeSource
  raw           Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([workplaceId, period, documentType, lawNo, kind])
  @@index([workplaceId, period])
}

// Hassas işlemlerin izi: şifre çözme, şifre değişikliği, SGK'ya yazma işlemleri
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?  // null ise sistem (zamanlanmış iş)
  action    String   // "vizite.credentials.update", "vizite.credentials.decrypt", "vizite.report.approve"
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Vergi takvimi (tüm bürolar için ortak)
model TaxCalendarEvent {
  id           String         @id @default(cuid())
  title        String         // "Eylül 2026 Dönemine Ait KDV Beyannamesi"
  dueDate      DateTime
  appliesTo    CompanyType[]  // boşsa herkes için
  createdAt    DateTime       @default(now())

  @@index([dueDate])
}

enum NotificationCategory {
  TEBLIGAT           // Yeni e-tebligat / tebliğ sayılma tarihi yaklaşıyor
  SGK_RAPOR          // Onay bekleyen e-Rapor
  BEYANNAME_SON_GUN  // Son günü yaklaşan, verilmemiş beyanname
  BEYANNAME_GECIKTI  // Son günü geçmiş beyanname
  EDEFTER            // e-Defter berat son günü yaklaşıyor / geçti
  SISTEM             // Senkron hataları, duyurular
}

model Notification {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  NotificationCategory @default(SISTEM)
  title     String
  body      String?
  link      String?              // Portal içi yol, ör. "/tebligat"
  // Aynı olay için ikinci bildirim üretilmez (ör. "deadline:KDV1:2026-09:3gun")
  dedupeKey String?
  createdAt DateTime             @default(now())

  reads      NotificationRead[]
  deliveries NotificationDelivery[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
}

// Okunma kullanıcı bazındadır: bir personelin okuması diğerleri için okundu saymaz
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
}

enum DeliveryChannel {
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

// Dış kanallara (WhatsApp) gönderim kaydı
model NotificationDelivery {
  id                String          @id @default(cuid())
  notificationId    String
  notification      Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           DeliveryChannel
  status            DeliveryStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime        @default(now())

  @@unique([notificationId, userId, channel])
}

enum TebligatSource {
  EXTENSION // GİB sayfasından eklentiyle aktarıldı
  DEMO
}

// GİB e-Tebligat. Elektronik tebligat, muhatabın elektronik adresine ulaştığı tarihi izleyen
// 5. günün sonunda tebliğ edilmiş sayılır (VUK 107/A); süreler bu tarihten başlar.
model ETebligat {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentNo     String         // Belge / tebligat numarası (yoksa içerikten türetilen anahtar)
  sender         String?        // Gönderen birim (ör. "Kadıköy Vergi Dairesi Müdürlüğü")
  subject        String?        // Konu / belge türü (ör. "Vergi/Ceza İhbarnamesi")
  deliveredAt    DateTime       // Elektronik adrese ulaşma (gönderim) tarihi
  deemedServedAt DateTime       // Tebliğ edilmiş sayılma tarihi (ulaşmayı izleyen 5. gün sonu)
  readAtGib      DateTime?      // GİB'de okunma tarihi (sayfada görünüyorsa)
  reviewedAt     DateTime?      // Büroda incelendi olarak işaretlenme
  reviewedById   String?
  source         TebligatSource
  raw            Json?
  createdAt      DateTime       @default(now())

  @@unique([companyId, documentNo])
  @@index([companyId, deliveredAt])
}

// Faz 6: Uzmana Sor / yapay zekâ asistanı. Sadece genel mevzuat soruları; mesajlar yapay zekâ servisine
// gönderilmeden önce kimlik/vergi/sicil numarası, IBAN, e-posta ve telefon maskelenir ve veritabanına da
// maskelenmiş hâliyle yazılır.
enum AssistantRole {
  USER
  ASSISTANT
}

model AssistantConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId       String                // Günlük kota sayımı için
  role           AssistantRole
  content        String
  redactions     Json?                 // { tckn: 1, iban: 1 } gibi: maskelenen bilgi türleri
  sources        Json?                 // Web aramasıyla bulunan kaynaklar [{ url, title }]
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([tenantId, role, createdAt])
}

// Faz 5c: e-Fatura / e-Arşiv faturaları. Kaynak: mükellefin entegratöründen dışa aktarılan UBL-TR XML (veya ZIP)
// dosyaları; ileride entegratör API'si. Tutarlar belge para biriminde; TL karşılığı için exchangeRate kullanılır.
enum InvoiceDirection {
  OUTGOING // Mükellefin kestiği (satış)
  INCOMING // Mükellefe kesilen (alış)
}

enum InvoiceSource {
  UBL_UPLOAD
  DEMO
}

model Invoice {
  id                    String           @id @default(cuid())
  companyId             String
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  direction             InvoiceDirection
  uuid                  String           // ETTN
  number                String           // Fatura no (ör. ABC2026000000123)
  issueDate             DateTime         @db.Date
  period                String           // YYYY-MM (düzenleme tarihine göre)
  profile               String           // TEMELFATURA, TICARIFATURA, EARSIVFATURA, IHRACAT…
  invoiceType           String           // SATIS, IADE, TEVKIFAT, ISTISNA, OZELMATRAH, IHRACKAYITLI…
  counterpartyTaxNumber String?
  counterpartyName      String?
  currency              String           @default("TRY")
  exchangeRate          Decimal?         @db.Decimal(14, 6)
  lineExtensionAmount   Decimal          @db.Decimal(16, 2) // Mal/hizmet toplamı
  taxExclusiveAmount    Decimal          @db.Decimal(16, 2) // Vergiler hariç (matrah)
  taxInclusiveAmount    Decimal          @db.Decimal(16, 2)
  payableAmount         Decimal          @db.Decimal(16, 2)
  vatAmount             Decimal          @db.Decimal(16, 2) // KDV (vergi kodu 0015) toplamı
  withholdingAmount     Decimal          @default(0) @db.Decimal(16, 2) // KDV tevkifatı
  taxes                 Json             // [{ code, name, rate, base, amount }]
  lineCount             Int
  source                InvoiceSource
  createdAt             DateTime         @default(now())

  @@unique([companyId, direction, uuid])
  @@index([companyId, period])
}

// Faz 5d: bordro takibi. Kaynak: bordro programının personel bazlı Excel/CSV çıktısı (programdan bağımsız,
// başlıktan tanınır). Portal bordro hesaplamaz; programın sonucunu saklar ve e-Bildirge ile karşılaştırır.
enum PayrollSource {
  EXCEL_UPLOAD
  DEMO
}

model PayrollRun {
  id                   String        @id @default(cuid())
  companyId            String
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workplaceId          String?
  workplace            SgkWorkplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  workplaceKey         String        // workplaceId ?? "" (tekillik için; Postgres NULL'ları eşit saymaz)
  period               String        // YYYY-MM
  source               PayrollSource
  fileName             String?
  employeeCount        Int
  totalDays            Int
  gross                Decimal       @db.Decimal(16, 2)
  sgkBase              Decimal       @db.Decimal(16, 2) // Prime esas kazanç (PEK)
  employeeSgk          Decimal       @db.Decimal(16, 2)
  employeeUnemployment Decimal       @db.Decimal(16, 2)
  employerSgk          Decimal?      @db.Decimal(16, 2)
  employerUnemployment Decimal?      @db.Decimal(16, 2)
  incomeTax            Decimal       @db.Decimal(16, 2)
  stampTax             Decimal       @db.Decimal(16, 2)
  net                  Decimal       @db.Decimal(16, 2)
  warningCount         Int           @default(0)
  uploadedById         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  lines                PayrollLine[]

  @@unique([companyId, workplaceKey, period])
  @@index([period])
}

model PayrollLine {
  id                   String     @id @default(cuid())
  runId                String
  run                  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tckn                 String
  fullName             String
  days                 Int
  gross                Decimal    @db.Decimal(14, 2)
  sgkBase              Decimal    @db.Decimal(14, 2)
  employeeSgk          Decimal    @db.Decimal(14, 2)
  employeeUnemployment Decimal    @db.Decimal(14, 2)
  employerSgk          Decimal?   @db.Decimal(14, 2)
  employerUnemployment Decimal?   @db.Decimal(14, 2)
  incomeTaxBase        Decimal?   @db.Decimal(14, 2)
  incomeTax            Decimal    @db.Decimal(14, 2)
  stampTax             Decimal    @db.Decimal(14, 2)
  net                  Decimal    @db.Decimal(14, 2)
  warnings             String[]   @default([])

  @@index([runId])
}

// İş kutusu: bir iş (ör. "decl:<firma>:KDV1:2026-09") büro genelinde belirli bir tarihe kadar ertelenebilir.
// İşlerin kendisi saklanmaz; her açılışta beyanname, tebligat, SGK, e-Defter ve bordro verisinden üretilir.
model InboxSnooze {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  until     DateTime
  userId    String
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
}
