DATABASE_URL="postgresql://mukellef:mukellef_dev@localhost:5432/mukellef?schema=public"
JWT_SECRET="degistirin"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Kurum şifrelerini şifrelemek için 32 baytlık base64 anahtar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Anahtar değişirse kayıtlı şifreler çözülemez. Üretimde KMS/Vault içinde tutun.
VAULT_KEY=""

# mock: SGK'ya bağlanmaz, sahte veri üretir. live: gerçek SGK Vizite servisine bağlanır.
SGK_MODE="mock"
# SGK_VIZITE_URL="https://uyg.sgk.gov.tr/Ws_Vizite/services/ViziteGonder"

REDIS_URL="redis://localhost:6379"

# mock: GİB'e bağlanmaz, sahte beyanname verisi üretir. live: henüz kurulmadı (veri kaynağı kararı bekleniyor).
GIB_MODE="mock"

# WhatsApp Business Cloud API (Meta). off: gönderim yok | mock: gönderilmiş gibi kaydedilir | live: gerçek gönderim
WHATSAPP_MODE="off"
# live için: Meta Business'ta onaylı şablon ("Mükellef Takip bildirimi: {{1}} — {{2}}", dil tr) ve aşağıdakiler
# WHATSAPP_GRAPH_VERSION="v<Meta'nın güncel Graph API sürümü>"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE="mukellef_bildirim"

# Ödeme sağlayıcısı. demo: gerçek para çekilmez. iyzico: iyzico Ödeme Formu.
BILLING_PROVIDER="demo"
# iyzico anahtarları: sandbox için https://sandbox-merchant.iyzipay.com → Ayarlar → Firma Ayarları
# IYZICO_API_KEY=""
# IYZICO_SECRET_KEY=""
# Sandbox (varsayılan): https://sandbox-api.iyzipay.com  —  Canlı: https://api.iyzipay.com
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Anahtarları girdikten sonra kontrol (ödeme oluşturmaz, anahtarları ekrana yazmaz):
#   npm run iyzico:check -w apps/api            (sandbox ödeme formu da denensin: -- --cf)
# iyzico ödeme sonrası kullanıcıyı bu API adresine geri gönderir (canlıda https olmalı)
API_PUBLIC_URL="http://localhost:4000/api"

# Faz 6 — "Uzmana Sor" yapay zekâ asistanı (sadece genel mevzuat soruları).
# Anahtar yoksa demo yanıtlar verilir. off: menü açık kalır ama soru sorulamaz.
# Anahtar: https://platform.claude.com → API Keys. Anahtarı sohbete/koda yazmayın, sadece .env dosyasına girin.
# ASSISTANT_MODE="anthropic"        # anthropic | mock | off
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-opus-5-5" # daha düşük maliyet için: claude-sonnet-5-5
# on: güncel oran/tutar sorularında yalnızca resmi sitelerde (GİB, SGK, Mevzuat, Resmî Gazete) web araması yapar
# ASSISTANT_WEB_SEARCH="off"
# Büro başına günlük soru sınırı
# ASSISTANT_DAILY_LIMIT=200
