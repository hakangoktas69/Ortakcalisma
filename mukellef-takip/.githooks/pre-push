#!/bin/sh
# Push öncesi kapı: gönderilen commit'ler mukellef-takip/ altında değişiklik içeriyorsa tam doğrulama çalışır
# (npm run verify: lint, tip, birim + API regresyon testleri). Kurulum: npm run hooks:install
# Acil durumda atlamak için: git push --no-verify (CI yine çalışır).
zero=0000000000000000000000000000000000000000
changed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^mukellef-takip/'; then changed=1; fi
done
[ "$changed" = 0 ] && exit 0
root=$(git rev-parse --show-toplevel)
echo "mukellef-takip değişti: push öncesi doğrulama çalışıyor…"
exec node "$root/mukellef-takip/infra/docker/scripts/verify.mjs"
