# Üretim kurulumu ayarları (sır içermez; sırlar secrets/ altında). Kopyalayın: cp .env.example .env
# Kullanım: docker compose -f compose.yml -f compose.prod.yml --env-file .env up -d --build

# Portalın alan adı (DNS bu sunucuyu göstermeli; Caddy TLS sertifikasını otomatik alır)
DOMAIN=portal.ornek-buro.com.tr

# Chrome Web Store'daki eklenti kimliği (32 harf). Boşsa her eklentiye CORS açılır (uyarı verilir).
EXTENSION_ID=

# Dış servis modları: canlıya geçmeden önce README'deki doğrulama adımlarına bakın
SGK_MODE=mock
GIB_MODE=mock
WHATSAPP_MODE=off
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=
BILLING_PROVIDER=iyzico
IYZICO_BASE_URL=https://api.iyzipay.com
# Yapay zekâ asistanı yurt dışı aktarım içerir (KVKK md.9): açmadan önce büro onayı akışını okuyun
ASSISTANT_MODE=off

# Tanıtım kurulumu (gerçek müşteri verisi YOK): demo ödeme ve yerel anahtara izin verir
DEMO_MODE=false

# Şifreli yedeklerin yazılacağı host dizini; kurum dışına (off-site) senkronlayın
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
