# Yerel geliştirme ayarları. Hızlı yol: npm run db:up && node infra/docker/scripts/dev-env.mjs > apps/api/.env
# Bütün değişkenler açılışta doğrulanır (src/platform/config/config.ts); üretimde güvensiz değerle uygulama açılmaz.
# Her değişken X_FILE biçiminde dosyadan da okunabilir (Docker secrets).

# Uygulama rolü (RLS'e tabi, tablo sahibi değil). Migration ve seed tablo sahibi rolüyle çalışır:
#   DATABASE_URL="$MIGRATE_DATABASE_URL" npx prisma migrate deploy
DATABASE_URL="postgresql://mukellef_app:<app_password>@127.0.0.1:5432/mukellef?schema=public"
MIGRATE_DATABASE_URL="postgresql://mukellef_owner:<owner_password>@127.0.0.1:5432/mukellef?schema=public"
REDIS_URL="redis://:<redis_password>@127.0.0.1:6379"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# LOG_LEVEL="info"
# LOG_PRETTY="true"

# En az 32 karakter rastgele: openssl rand -base64 48 (geliştirmede zayıf değer yalnız uyarı verir)
JWT_SECRET=""
# Erişim anahtarı ömrü (web BFF oturumuna geçince 15m), yenileme ve eklenti anahtarı ömürleri
# ACCESS_TOKEN_TTL="8h"
# REFRESH_TOKEN_TTL_DAYS=7
# API_TOKEN_TTL_DAYS=90

# Anahtar yönetimi (docs/adr/0005). local: VAULT_KEY (geliştirme) | openbao: OpenBao Transit (canlı)
KMS_PROVIDER="local"
# 32 baytlık base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Anahtar değişirse kayıtlı şifreler ve şifreli kişisel veri çözülemez.
VAULT_KEY=""
# OPENBAO_ADDR="http://openbao:8200"
# OPENBAO_TOKEN=""
# OPENBAO_WRAPPED_DEK="vault:v1:..."

# mock: SGK'ya bağlanmaz, sahte veri üretir. live: gerçek SGK Vizite servisine bağlanır.
SGK_MODE="mock"
# SGK_VIZITE_URL="https://uyg.sgk.gov.tr/Ws_Vizite/services/ViziteGonder"

# mock: GİB'e bağlanmaz, sahte beyanname verisi üretir. live: henüz kurulmadı (veri kaynağı kararı bekleniyor).
GIB_MODE="mock"

# WhatsApp Business Cloud API (Meta). off | mock (gönderilmiş gibi kaydedilir) | live
# Mesajlarda kişisel veri gitmez: yalnız kategori ve kişisel veri içermeyen kısa metin (KVKK md.9).
WHATSAPP_MODE="off"
# WHATSAPP_GRAPH_VERSION="v<Meta'nın güncel Graph API sürümü>"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_TEMPLATE="mukellef_bildirim"

# Ödeme sağlayıcısı. demo: gerçek para çekilmez (üretimde yalnız DEMO_MODE=true ile). iyzico: iyzico Ödeme Formu.
BILLING_PROVIDER="demo"
# IYZICO_API_KEY=""
# IYZICO_SECRET_KEY=""
# Sandbox (varsayılan): https://sandbox-api.iyzipay.com  —  Canlı: https://api.iyzipay.com
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"
# Anahtarları girdikten sonra kontrol (ödeme oluşturmaz, anahtarları ekrana yazmaz):
#   npm run iyzico:check -w apps/api            (sandbox ödeme formu da denensin: -- --cf)
# iyzico ödeme sonrası kullanıcıyı bu API adresine geri gönderir (canlıda https olmalı)
API_PUBLIC_URL="http://localhost:4000/api"

# "Uzmana Sor" yapay zekâ asistanı (sadece genel mevzuat soruları). anthropic modunda sorular yurt dışına
# gider: büro yöneticisi Ayarlar'dan onay vermeden çalışmaz (PUT /api/assistant/consent).
# ASSISTANT_MODE="anthropic"        # anthropic | mock | off
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-opus-5-5" # daha düşük maliyet için: claude-sonnet-5-5
# ASSISTANT_WEB_SEARCH="off"
# ASSISTANT_DAILY_LIMIT=200
